new file mode 100644
--- /dev/null
+++ b/src/vela_background.h
@@ -0,0 +1,166 @@
+#pragma once
+// Vela experimental background. Alpha-only atlas textures work in both existing
+// MangoHud renderers, without extra GPU resources or game-frame readback.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include "imgui.h"
+
+inline void vela_background_reserve(ImFontAtlas* atlas)
+{
+    atlas->AddCustomRectRegular(64, 64);
+    atlas->AddCustomRectRegular(512, 512);
+    atlas->AddCustomRectRegular(64, 64); // Dark grain, separate from light grain.
+}
+
+inline float vela_shape_distance(float x, float y, float radius)
+{
+    const float qx = std::abs(x - 256.f) - 160.f + radius;
+    const float qy = std::abs(y - 256.f) - 160.f + radius;
+    return std::min(std::max(qx, qy), 0.f) + std::hypot(std::max(qx, 0.f), std::max(qy, 0.f)) - radius;
+}
+
+inline void vela_background_bake(ImFontAtlas* atlas, float rounding, float blur, float offset_x, float offset_y)
+{
+    rounding = std::isfinite(rounding) ? std::clamp(rounding, 0.f, 100.f) : 0.f;
+    blur = std::isfinite(blur) ? std::clamp(blur, 0.f, 40.f) : 16.f;
+    offset_x = std::isfinite(offset_x) ? std::clamp(offset_x, -40.f, 40.f) : 0.f;
+    offset_y = std::isfinite(offset_y) ? std::clamp(offset_y, -40.f, 40.f) : 4.f;
+    unsigned char* pixels;
+    int width, height;
+    atlas->GetTexDataAsAlpha8(&pixels, &width, &height);
+    for (int index = 0; index < 3; ++index) {
+        const auto* rect = atlas->GetCustomRectByIndex(index);
+        for (int y = 0; y < rect->Height; ++y) {
+            for (int x = 0; x < rect->Width; ++x) {
+                unsigned char alpha;
+                if (index != 1) {
+                    uint32_t seed = uint32_t(x + y * 64 + 1) * 0x9e3779b9u;
+                    seed ^= seed >> 16;
+                    seed *= 0x85ebca6bu;
+                    seed ^= seed >> 13;
+                    // Difference of two samples clusters near zero; cap contrast at
+                    // 31/255 even with the opacity control at 100%.
+                    const int grain = int((seed >> 24) & 255) - int((seed >> 8) & 255);
+                    alpha = static_cast<unsigned char>(std::max(0, index == 0 ? grain : -grain) / 8);
+                } else {
+                    // A precomputed rounded shadow, with the panel's interior
+                    // knocked out so transparent backgrounds stay transparent.
+                    const float px = x + .5f, py = y + .5f;
+                    const float outside = std::clamp(vela_shape_distance(px, py, rounding) + .5f, 0.f, 1.f);
+                    const float distance = vela_shape_distance(px - offset_x, py - offset_y, rounding);
+                    const float coverage = blur > 0.f
+                        ? .5f * std::erfc(distance / (1.41421356f * std::max(.1f, blur / 3.f)))
+                        : std::clamp(.5f - distance, 0.f, 1.f);
+                    alpha = static_cast<unsigned char>(std::round(255.f * outside * coverage));
+                }
+                pixels[(rect->Y + y) * width + rect->X + x] = alpha;
+            }
+        }
+    }
+}
+
+inline float vela_background_clamp(float value)
+{
+    return std::isfinite(value) ? std::clamp(value, 0.f, 1.f) : 0.f;
+}
+
+inline void vela_background_draw(float noise, float opacity, float rounding)
+{
+    noise = vela_background_clamp(noise);
+    opacity = vela_background_clamp(opacity);
+    if (noise == 0.f || opacity == 0.f)
+        return;
+    auto* atlas = ImGui::GetIO().Fonts;
+    if (atlas->CustomRects.Size < 3)
+        return;
+    auto* draw = ImGui::GetWindowDrawList();
+    const ImVec2 pos = ImGui::GetWindowPos(), size = ImGui::GetWindowSize();
+    const float radius = std::clamp(rounding, 0.f, std::min(size.x, size.y) * .5f);
+    draw->PushClipRect(pos, ImVec2(pos.x + size.x, pos.y + size.y), false);
+    if (noise > 0.f) {
+        ImVec2 uv0, uv1, dark_uv0, dark_uv1;
+        atlas->CalcCustomRectUV(atlas->GetCustomRectByIndex(0), &uv0, &uv1);
+        atlas->CalcCustomRectUV(atlas->GetCustomRectByIndex(2), &dark_uv0, &dark_uv1);
+        // Even tiles avoid a tiny final tile that cannot contain the outer corner.
+        const float step = std::max(64.f, radius * 2.f);
+        const int nx = std::max(1, int(std::floor(size.x / step)));
+        const int ny = std::max(1, int(std::floor(size.y / step)));
+        for (int y = 0; y < ny; ++y) {
+            for (int x = 0; x < nx; ++x) {
+                ImDrawFlags flags = ImDrawFlags_RoundCornersNone;
+                if (x == 0 && y == 0) flags |= ImDrawFlags_RoundCornersTopLeft;
+                if (x == nx-1 && y == 0) flags |= ImDrawFlags_RoundCornersTopRight;
+                if (x == 0 && y == ny-1) flags |= ImDrawFlags_RoundCornersBottomLeft;
+                if (x == nx-1 && y == ny-1) flags |= ImDrawFlags_RoundCornersBottomRight;
+                if (flags != ImDrawFlags_RoundCornersNone) flags &= ~ImDrawFlags_RoundCornersNone;
+                ImVec2 a(pos.x + size.x * x/nx, pos.y + size.y * y/ny);
+                ImVec2 b(pos.x + size.x * (x+1)/nx, pos.y + size.y * (y+1)/ny);
+                draw->AddImageRounded(atlas->TexID, a, b, uv0, uv1,
+                    IM_COL32(255,255,255, int(std::round(255.f * noise * opacity))), radius, flags);
+                draw->AddImageRounded(atlas->TexID, a, b, dark_uv0, dark_uv1,
+                    IM_COL32(0,0,0, int(std::round(255.f * noise * opacity))), radius, flags);
+            }
+        }
+    }
+    draw->PopClipRect();
+}
+
+// The border is drawn independently of background opacity and inset so that
+// thick strokes remain inside the HUD bounds instead of being clipped.
+inline void vela_border_draw(float thickness, float opacity, unsigned rgb, float rounding)
+{
+    opacity = vela_background_clamp(opacity);
+    if (!std::isfinite(thickness) || thickness <= 0.f || opacity <= 0.f)
+        return;
+    const ImVec2 pos = ImGui::GetWindowPos(), size = ImGui::GetWindowSize();
+    thickness = std::min(std::clamp(thickness, 0.f, 8.f), std::min(size.x, size.y) * .5f);
+    const float inset = thickness * .5f + .5f;
+    const float radius = std::max(0.f, std::min(rounding, std::min(size.x, size.y) * .5f) - inset);
+    const ImU32 color = IM_COL32((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255,
+                                int(std::round(opacity * 255.f)));
+    auto* draw = ImGui::GetWindowDrawList();
+    draw->PushClipRect(pos, ImVec2(pos.x + size.x, pos.y + size.y), false);
+    const auto old_flags = draw->Flags;
+    draw->Flags |= ImDrawListFlags_AntiAliasedLines;
+    draw->AddRect(ImVec2(pos.x + inset, pos.y + inset),
+                  ImVec2(pos.x + size.x - inset, pos.y + size.y - inset),
+                  color, radius, 0, thickness);
+    draw->Flags = old_flags;
+    draw->PopClipRect();
+}
+
+// Nine-slice a baked shadow on the background draw list. Its clip is the whole
+// viewport, not the HUD's inner clip, so the soft edges can extend past the panel.
+inline void vela_shadow_draw(float opacity, unsigned rgb, float rounding, float offset_x, float offset_y)
+{
+    opacity = vela_background_clamp(opacity);
+    if (opacity <= 0.f)
+        return;
+    auto* atlas = ImGui::GetIO().Fonts;
+    if (atlas->CustomRects.Size < 3)
+        return;
+    rounding = std::isfinite(rounding) ? std::clamp(rounding, 0.f, 100.f) : 0.f;
+    offset_x = std::isfinite(offset_x) ? std::clamp(offset_x, -40.f, 40.f) : 0.f;
+    offset_y = std::isfinite(offset_y) ? std::clamp(offset_y, -40.f, 40.f) : 4.f;
+    const ImVec2 pos = ImGui::GetWindowPos(), size = ImGui::GetWindowSize();
+    const float edge = 96.f + rounding + std::max(std::abs(offset_x), std::abs(offset_y)) + 2.f;
+    const float ex = std::min(edge, (size.x + 192.f) * .5f);
+    const float ey = std::min(edge, (size.y + 192.f) * .5f);
+    const float xs[] = {pos.x - 96.f, pos.x - 96.f + ex, pos.x + size.x + 96.f - ex, pos.x + size.x + 96.f};
+    const float ys[] = {pos.y - 96.f, pos.y - 96.f + ey, pos.y + size.y + 96.f - ey, pos.y + size.y + 96.f};
+    const float source[] = {0.f, edge / 512.f, 1.f - edge / 512.f, 1.f};
+    ImVec2 uv0, uv1;
+    atlas->CalcCustomRectUV(atlas->GetCustomRectByIndex(1), &uv0, &uv1);
+    const ImU32 color = IM_COL32((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255, int(std::round(opacity * 255.f)));
+    auto* draw = ImGui::GetBackgroundDrawList();
+    for (int y = 0; y < 3; ++y) {
+        for (int x = 0; x < 3; ++x) {
+            if (xs[x+1] <= xs[x] || ys[y+1] <= ys[y])
+                continue;
+            draw->AddImage(atlas->TexID, ImVec2(xs[x], ys[y]), ImVec2(xs[x+1], ys[y+1]),
+                ImVec2(uv0.x + (uv1.x-uv0.x)*source[x], uv0.y + (uv1.y-uv0.y)*source[y]),
+                ImVec2(uv0.x + (uv1.x-uv0.x)*source[x+1], uv0.y + (uv1.y-uv0.y)*source[y+1]), color);
+        }
+    }
+}
diff --git a/src/vela_blur.h b/src/vela_blur.h
new file mode 100644
--- /dev/null
+++ b/src/vela_blur.h
@@ -0,0 +1,48 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include "imgui.h"
+
+// Private texture tag; backends replace it with a GPU snapshot of this frame.
+inline ImTextureID vela_blur_texture() { return reinterpret_cast<ImTextureID>(uintptr_t(0x56424c55)); }
+struct VelaBlurRequest { bool active=false; ImVec2 pos{}, size{}; float radius=0; };
+inline thread_local VelaBlurRequest vela_blur_request;
+inline thread_local bool vela_blur_available = false;
+struct VelaBlurRegion {
+    int x=0, y=0, width=0, height=0, texture_width=0, texture_height=0;
+    float constants[8] = {}; // step.xy, mode, reserved, uv origin.xy, uv scale.xy
+};
+inline VelaBlurRegion vela_blur_region(int width, int height, float sx=1.f, float sy=1.f)
+{
+    VelaBlurRegion r;
+    if (!vela_blur_request.active || width<=0 || height<=0) return r;
+    const auto& q=vela_blur_request;
+    const float radius=q.radius*std::max(sx,sy);
+    const int margin=int(std::ceil(radius))+4;
+    r.x=std::clamp(int(std::floor(q.pos.x*sx))-margin,0,width);
+    r.y=std::clamp(int(std::floor(q.pos.y*sy))-margin,0,height);
+    const int right=std::clamp(int(std::ceil((q.pos.x+q.size.x)*sx))+margin,0,width);
+    const int bottom=std::clamp(int(std::ceil((q.pos.y+q.size.y)*sy))+margin,0,height);
+    r.width=right-r.x; r.height=bottom-r.y;
+    if (r.width<=0 || r.height<=0) return r;
+    r.texture_width=std::max(1,(r.width+3)/4);
+    r.texture_height=std::max(1,(r.height+3)/4);
+    r.constants[0]=radius/(4.f*r.width); r.constants[1]=radius/(4.f*r.height);
+    r.constants[2]=1;
+    r.constants[4]=(q.pos.x*sx-r.x)/r.width;
+    r.constants[5]=(q.pos.y*sy-r.y)/r.height;
+    r.constants[6]=q.size.x*sx/r.width;
+    r.constants[7]=q.size.y*sy/r.height;
+    return r;
+}
+inline void vela_blur_draw(float radius, float rounding)
+{
+    if (!vela_blur_available || !std::isfinite(radius) || radius<=0) return;
+    auto& q=vela_blur_request;
+    q.active=true; q.pos=ImGui::GetWindowPos(); q.size=ImGui::GetWindowSize();
+    q.radius=std::clamp(radius,0.f,32.f);
+    ImGui::GetBackgroundDrawList()->AddImageRounded(vela_blur_texture(),q.pos,
+        ImVec2(q.pos.x+q.size.x,q.pos.y+q.size.y),ImVec2(0,0),ImVec2(1,1),
+        IM_COL32_WHITE,std::clamp(rounding,0.f,std::min(q.size.x,q.size.y)*.5f));
+}
diff --git a/src/vela_blur_vk.h b/src/vela_blur_vk.h
new file mode 100644
--- /dev/null
+++ b/src/vela_blur_vk.h
@@ -0,0 +1,59 @@
+#pragma once
+// Included after MangoHud's image-allocation helpers. One capture per in-flight
+// overlay draw; reuse is protected by the existing per-draw fence.
+static void vela_vk_destroy_capture(device_data* device, overlay_draw* draw)
+{
+    if (draw->blur_view) device->vtable.DestroyImageView(device->device, draw->blur_view, nullptr);
+    if (draw->blur_image) device->vtable.DestroyImage(device->device, draw->blur_image, nullptr);
+    if (draw->blur_memory) device->vtable.FreeMemory(device->device, draw->blur_memory, nullptr);
+    draw->blur_view=VK_NULL_HANDLE; draw->blur_image=VK_NULL_HANDLE; draw->blur_memory=VK_NULL_HANDLE;
+}
+static bool vela_vk_prepare_capture(swapchain_data* data, overlay_draw* draw, const VelaBlurRegion& roi)
+{
+    if (roi.width<=0 || roi.height<=0) return false;
+    if (draw->blur_width==unsigned(roi.texture_width) && draw->blur_height==unsigned(roi.texture_height) && draw->blur_image)
+        return true;
+    vela_vk_destroy_capture(data->device,draw);
+    if (!draw->blur_descriptor)
+        draw->blur_descriptor=create_image_with_desc(data,roi.texture_width,roi.texture_height,data->format,
+            draw->blur_image,draw->blur_memory,draw->blur_view);
+    else
+        create_image(data,draw->blur_descriptor,roi.texture_width,roi.texture_height,data->format,
+            draw->blur_image,draw->blur_memory,draw->blur_view);
+    draw->blur_width=roi.texture_width; draw->blur_height=roi.texture_height;
+    return draw->blur_image!=VK_NULL_HANDLE;
+}
+static void vela_vk_record_capture(swapchain_data* data, overlay_draw* draw, unsigned index, const VelaBlurRegion& roi)
+{
+    auto& api=data->device->vtable;
+    VkImageMemoryBarrier destination{};
+    destination.sType=VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+    destination.dstAccessMask=VK_ACCESS_TRANSFER_WRITE_BIT;
+    destination.oldLayout=VK_IMAGE_LAYOUT_UNDEFINED;
+    destination.newLayout=VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    destination.srcQueueFamilyIndex=destination.dstQueueFamilyIndex=VK_QUEUE_FAMILY_IGNORED;
+    destination.image=draw->blur_image;
+    destination.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};
+    api.CmdPipelineBarrier(draw->command_buffer,VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,VK_PIPELINE_STAGE_TRANSFER_BIT,
+        0,0,nullptr,0,nullptr,1,&destination);
+    VkImageBlit region{};
+    region.srcSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,0,1};
+    region.dstSubresource=region.srcSubresource;
+    region.srcOffsets[0]={roi.x,roi.y,0};
+    region.srcOffsets[1]={roi.x+roi.width,roi.y+roi.height,1};
+    region.dstOffsets[1]={roi.texture_width,roi.texture_height,1};
+    api.CmdBlitImage(draw->command_buffer,data->images[index],VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        draw->blur_image,VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,1,&region,VK_FILTER_LINEAR);
+    VkImageMemoryBarrier barriers[2]={destination,destination};
+    barriers[0].srcAccessMask=VK_ACCESS_TRANSFER_WRITE_BIT;
+    barriers[0].dstAccessMask=VK_ACCESS_SHADER_READ_BIT;
+    barriers[0].oldLayout=VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    barriers[0].newLayout=VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+    barriers[1].image=data->images[index];
+    barriers[1].srcAccessMask=VK_ACCESS_TRANSFER_READ_BIT;
+    barriers[1].dstAccessMask=VK_ACCESS_COLOR_ATTACHMENT_READ_BIT|VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+    barriers[1].oldLayout=VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    barriers[1].newLayout=VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    api.CmdPipelineBarrier(draw->command_buffer,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_ALL_GRAPHICS_BIT,
+        0,0,nullptr,0,nullptr,2,barriers);
+}
diff --git a/src/gl/vela_blur_gl.h b/src/gl/vela_blur_gl.h
new file mode 100644
--- /dev/null
+++ b/src/gl/vela_blur_gl.h
@@ -0,0 +1,55 @@
+#pragma once
+// Called inside the renderer's state backup/restore scope, before any HUD draw.
+static bool vela_gl_capture(gl_context* ctx,const VelaBlurRegion& roi,int fb_height)
+{
+    if (!vela_blur_request.active || roi.width<=0 || roi.height<=0 || !glBlitFramebuffer)
+        return false;
+    GLint read_fb,draw_fb,unpack_buffer;
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING,&unpack_buffer);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER,0);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING,&read_fb);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING,&draw_fb);
+    const GLint source=params.gl_bind_framebuffer>=0 ? params.gl_bind_framebuffer : draw_fb;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,source);
+    GLint source_read_buffer;
+    glGetIntegerv(GL_READ_BUFFER,&source_read_buffer);
+    if (source==0) glReadBuffer(GL_BACK);
+    glDisable(GL_SCISSOR_TEST);
+    glDisable(GL_FRAMEBUFFER_SRGB); // Capture SDR code values; HUD renderer also writes code values.
+    if (!ctx->BlurTexture) {
+        glGenTextures(1,&ctx->BlurTexture); glGenTextures(1,&ctx->BlurResolveTexture);
+        glGenFramebuffers(1,&ctx->BlurFramebuffer); glGenFramebuffers(1,&ctx->BlurResolveFramebuffer);
+    }
+    auto allocate=[](GLuint texture,int width,int height) {
+        glBindTexture(GL_TEXTURE_2D,texture);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MIN_FILTER,GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_MAG_FILTER,GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_S,GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D,GL_TEXTURE_WRAP_T,GL_CLAMP_TO_EDGE);
+        glTexImage2D(GL_TEXTURE_2D,0,GL_RGBA8,width,height,0,GL_RGBA,GL_UNSIGNED_BYTE,nullptr);
+    };
+    // Resolve at identical size first: MSAA framebuffers cannot be resolved
+    // directly into a smaller image. The second blit downsamples by four.
+    if (ctx->BlurWidth!=roi.width || ctx->BlurHeight!=roi.height) {
+        allocate(ctx->BlurResolveTexture,roi.width,roi.height);
+        allocate(ctx->BlurTexture,roi.texture_width,roi.texture_height);
+        ctx->BlurWidth=roi.width; ctx->BlurHeight=roi.height;
+    }
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,ctx->BlurResolveFramebuffer);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,ctx->BlurResolveTexture,0);
+    const bool resolve_ok=glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER)==GL_FRAMEBUFFER_COMPLETE;
+    if (resolve_ok)
+        glBlitFramebuffer(roi.x,fb_height-roi.y-roi.height,roi.x+roi.width,fb_height-roi.y,
+            0,0,roi.width,roi.height,GL_COLOR_BUFFER_BIT,GL_NEAREST);
+    if (source==0) glReadBuffer(source_read_buffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,ctx->BlurResolveFramebuffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,ctx->BlurFramebuffer);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER,GL_COLOR_ATTACHMENT0,GL_TEXTURE_2D,ctx->BlurTexture,0);
+    const bool target_ok=glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER)==GL_FRAMEBUFFER_COMPLETE;
+    if (resolve_ok && target_ok)
+        glBlitFramebuffer(0,0,roi.width,roi.height,0,0,roi.texture_width,roi.texture_height,GL_COLOR_BUFFER_BIT,GL_LINEAR);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER,unpack_buffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER,read_fb);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER,draw_fb);
+    return resolve_ok && target_ok;
+}
diff --git a/src/vela_color_state.h b/src/vela_color_state.h
new file mode 100644
--- /dev/null
+++ b/src/vela_color_state.h
@@ -0,0 +1,14 @@
+#pragma once
+// Runtime transfer state belongs to the presented surface, never to a saved
+// configuration snapshot. Keep the last snapshot alive to avoid pointer reuse.
+template<class Snapshot> struct VelaColorState {
+    const void* context=nullptr;
+    Snapshot snapshot;
+    template<class Apply> void sync(const void* current_context, const Snapshot& current, bool dirty, Apply apply) {
+        if (context==current_context && snapshot==current && !dirty) return;
+        auto local=*current;
+        apply(local);
+        context=current_context;
+        snapshot=current;
+    }
+};
