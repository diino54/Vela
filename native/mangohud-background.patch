+        for (int y=-4;y<=4;++y) for (int x=-4;x<=4;++x) {
+            float w=velaWeight(x)*velaWeight(y);
+            sum+=texture(sTexture,clamp(uv+vec2(x,y)*pc.step,vec2(0),vec2(1))).rgb*w; total+=w;
+        }
+        fColor=vec4(sum/total,In.Color.a);
+    }
 }
