+bool reshade::runtime::ensure_vela_blur()
+{
+    if (_vela_blur_srv != 0) return true;
+    if (_vela_blur_failed || _renderer_id < 0xa000 || _is_vr) return false;
+    _vela_blur_failed = true;
+    auto desc = _device->get_resource_desc(_device->get_resource_from_view(_back_buffer_targets[_back_buffer_resolved != 0 ? 0 : get_current_back_buffer_index() * 2]));
+    if ((desc.type != api::resource_type::texture_2d && desc.type != api::resource_type::surface) || desc.texture.samples != 1 || desc.texture.depth_or_layers != 1) return false;
+    desc.type = api::resource_type::texture_2d;
+    desc.texture.format = api::format_to_default_typed(_back_buffer_format, 0);
+    desc.heap = api::memory_heap::default_;
+    desc.usage = api::resource_usage::copy_dest | api::resource_usage::shader_resource;
+    desc.flags = api::resource_flags::none;
+    if (!_device->create_resource(desc, nullptr, api::resource_usage::shader_resource, &_vela_blur_texture)) {
+        log::message(log::level::warning, "Vela backdrop unavailable: texture allocation failed"); return false;
+    }
+    if (!_device->create_resource_view(_vela_blur_texture, api::resource_usage::shader_resource, api::resource_view_desc(desc.texture.format), &_vela_blur_srv)) {
+        _device->destroy_resource(_vela_blur_texture); _vela_blur_texture = {};
+        log::message(log::level::warning, "Vela backdrop unavailable: texture view failed"); return false;
+    }
+    _device->set_resource_name(_vela_blur_texture, "Vela GPU backdrop capture");
+    log::message(log::level::info, "Vela GPU backdrop ready: %ux%u format=%u color_space=%u", _width, _height, static_cast<uint32_t>(desc.texture.format), static_cast<uint32_t>(_back_buffer_color_space));
+    _vela_blur_failed = false;
+    return true;
+}
 void reshade::runtime::destroy_imgui_resources()
 {
+    if (_vela_blur_texture != 0) {
+        _graphics_queue->wait_idle();
+        _device->destroy_resource_view(_vela_blur_srv); _vela_blur_srv = {};
+        _device->destroy_resource(_vela_blur_texture); _vela_blur_texture = {};
+    }
+    _vela_blur_failed = false;
+
 	ImFontAtlas *const atlas = _imgui_context->IO.Fonts;
 	atlas->Clear();
 
